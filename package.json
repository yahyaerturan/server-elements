{
  "name": "@server-elements/core",
  "version": "2.0.1",
  "description": "A small, standards-first component layer for server-rendered CodeIgniter 4 applications. Zero runtime dependencies.",
  "keywords": [
    "custom-elements",
    "web-components",
    "codeigniter",
    "codeigniter4",
    "ci4",
    "server-rendered",
    "progressive-enhancement",
    "zero-dependencies",
    "no-build",
    "esm",
    "accessibility"
  ],
  "homepage": "https://github.com/yahyaerturan/server-elements#readme",
  "bugs": {
    "url": "https://github.com/yahyaerturan/server-elements/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahyaerturan/server-elements.git"
  },
  "license": "MIT",
  "author": "Yahya A. Erturan <root@yahyaerturan.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "resources/js",
    "resources/css",
    "docs",
    "scripts/rename-to-server-elements.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./resources/js/core/index.js",
    "./core": "./resources/js/core/index.js",
    "./actions": "./resources/js/core/ActionRegistry.js",
    "./ci4": "./resources/js/ci4/index.js",
    "./components/*": "./resources/js/components/*",
    "./server-elements.css": "./resources/css/server-elements.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\"",
    "deps:check": "node scripts/check-runtime-deps.mjs",
    "arch:check": "node scripts/check-architecture.mjs",
    "css:check": "node scripts/check-logical-css.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:browser": "playwright test --project=browser --project=browser-firefox --project=browser-webkit",
    "test:browser:chromium": "playwright test --project=browser",
    "test:a11y": "playwright test --project=browser tests/browser/accessibility.spec.js",
    "test:integration": "playwright test --project=integration",
    "test": "npm run deps:check && npm run arch:check && npm run css:check && npm run lint && npm run test:unit && npm run test:browser && npm run test:integration",
    "prepublishOnly": "npm run deps:check && npm run arch:check && npm run css:check && npm run lint && npm run format:check && npm run test:unit && npm run build",
    "build": "vite build",
    "kit:css": "tailwindcss -i examples/dashboard/src/kit.css -o examples/dashboard/kit.css",
    "kit:watch": "tailwindcss -i examples/dashboard/src/kit.css -o examples/dashboard/kit.css --watch",
    "size": "node scripts/check-bundle-size.mjs",
    "ci4:install": "node scripts/ci4-setup.mjs",
    "ci4:serve": "php -S 127.0.0.1:8081 -t ci4/public ci4/public/rewrite.php"
  },
  "browserslist": [
    "chrome >= 116",
    "edge >= 116",
    "firefox >= 124",
    "safari >= 17.4"
  ]
}
